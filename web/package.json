{
  "name": "kestrel-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/check-env.mjs && vite build && node scripts/headers.mjs",
    "guide": "python3 scripts/gen-guide.py",
    "deploy:relay": "wrangler deploy --config worker/wrangler.toml --env production",
    "preview": "vite preview",
    "test": "vitest run",
    "relay": "wrangler dev --config worker/wrangler.toml --port 8787",
    "build:local": "VITE_RELAY_URL=http://localhost:8787 KESTREL_LOCAL_BUILD=1 npm run build"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "4.14.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
